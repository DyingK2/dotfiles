[Unit]
Description=LibreChat MongoDB

[Container]
ContainerName=librechat-mongo
Image=docker.io/library/mongo:8.0.20
Pod=librechat.pod
# 只在 pod 内可达,与上游 compose 一样不开鉴权
Exec=mongod --noauth --bind_ip 127.0.0.1
Volume=%h/.local/share/librechat/mongo:/data/db

[Service]
Restart=always

[Install]
WantedBy=default.target
