[Unit]
Description=LibreChat
Requires=librechat-mongo.service
After=librechat-mongo.service

[Container]
ContainerName=librechat
# 钉版本;升级 = 改这里的 tag 再 daemon-reload + restart
Image=ghcr.io/librechat-ai/librechat:v0.8.8
Pod=librechat.pod
# 只装密钥(CREDS_KEY/IV、JWT、ANTHROPIC_API_KEY),不进 git;模板见 .env.example
EnvironmentFile=%h/.config/librechat/.env
Environment=HOST=0.0.0.0 PORT=3080
Environment=MONGO_URI=mongodb://127.0.0.1:27017/LibreChat
Environment=DOMAIN_CLIENT=http://localhost:3080 DOMAIN_SERVER=http://localhost:3080
Environment=NO_INDEX=true SEARCH=false
# 单实例无 Redis:声明单副本,否则定时任务模块拒绝启动(日志报 scheduler NOT started)
Environment=SCHEDULES_SINGLE_PROCESS=true
Environment=ENDPOINTS=anthropic
Environment=ANTHROPIC_REVERSE_PROXY=https://api.lmuai.ai
# opus 日用;haiku 用于生成对话标题(librechat.yaml titleModel),也可在模型选择里手选
Environment=ANTHROPIC_MODELS=claude-opus-5-5,claude-haiku-5-5
# 单用户,已注册完(2026-11-12),注册关闭;要加人临时改 true
Environment=ALLOW_REGISTRATION=false ALLOW_SOCIAL_LOGIN=false ALLOW_SOCIAL_REGISTRATION=false
Volume=%h/.config/librechat/librechat.yaml:/app/librechat.yaml:ro
Volume=%h/.local/share/librechat/uploads:/app/uploads
Volume=%h/.local/share/librechat/images:/app/client/public/images
Volume=%h/.local/share/librechat/logs:/app/logs
Volume=%h/.local/share/librechat/data:/app/data

[Service]
Restart=always
# 首次拉镜像较慢
TimeoutStartSec=900

[Install]
WantedBy=default.target
